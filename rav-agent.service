[Unit]
Description=RAV-REMOTE Laptop Agent
After=network.target

[Service]
Type=simple
User=rav
WorkingDirectory=/home/rav/Development/RAV-REMOTE
EnvironmentFile=/home/rav/Development/RAV-REMOTE/.env
ExecStart=/home/rav/Development/RAV-REMOTE/deploy/start-agent.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
