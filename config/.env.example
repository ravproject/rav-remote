# ── BOT CREDENTIALS ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WHATSAPP_SESSION_PATH=./sessions/wa_session

# ── AUTH & SECURITY ──────────────────────────────────────
OTP_SECRET_KEY=your_base32_otp_secret_here         # generate: pyotp.random_base32()
JWT_SECRET_KEY=your_256bit_jwt_secret_here
ALLOWED_USER_IDS=123456789,987654321               # Telegram/WA user IDs
ENCRYPTION_KEY=your_32byte_aes_key_base64_here     # AES-256

# ── AGENT IDENTIFICATION ─────────────────────────────────
RAV_MODE=hub                                       # hub = bot+agent utama | agent = komputer tambahan
AGENT_ID=MyLaptop                                  # Unique identifier for this agent
AGENT_HOST=localhost
AGENT_PORT=8765
AGENT_BIND_HOST=0.0.0.0                            # 0.0.0.0 untuk multi-komputer (LAN/Tailscale)
AGENT_API_KEY=your_internal_api_key_here           # Internal auth antara bot & agent

# ── FLEET / MULTI-KOMPUTER ───────────────────────────────
FLEET_PAIRING_KEY=                                 # Auto-generated saat setup hub
HUB_URL=http://192.168.1.10:8765                   # URL hub (agent mode saja)

# ── NVIDIA NIM (OPSIONAL) ────────────────────────────────
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx       # Dari build.nvidia.com
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
AI_MODE_ENABLED=true                               # true/false

# ── FAST AI (UNTUK SUMMARIZATION) ────────────────────────
# Lebih cepat dari NVIDIA NIM. Support OpenAI-compatible API.
# Bisa pakai: llama-3.1-8b, gemini-2.0-flash, gpt-4o-mini, claude-3-haiku, dll
FAST_AI_API_KEY=                                  # Kosongkan untuk pakai NVIDIA_NIM_API_KEY
FAST_AI_BASE_URL=https://integrate.api.nvidia.com/v1
FAST_AI_MODEL=meta/llama-3.1-8b-instruct          # 8x lebih cepat dari 70B!
FAST_AI_ENABLED=true

# ── RATE LIMITING ────────────────────────────────────────
MAX_COMMANDS_PER_MINUTE=10
MAX_FILE_SIZE_MB=50

# ── LOGGING ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/audit.log
