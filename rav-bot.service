[Unit]
Description=RAV-REMOTE Telegram Bot
After=network.target rav-agent.service
BindsTo=rav-agent.service

[Service]
Type=simple
User=rav
WorkingDirectory=/home/rav/Development/RAV-REMOTE
EnvironmentFile=/home/rav/Development/RAV-REMOTE/.env
ExecStart=/home/rav/Development/RAV-REMOTE/deploy/start-bot.sh
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
